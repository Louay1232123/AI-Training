# Password for the single admin (required for /admin to work).
ADMIN_PASSWORD=change-me

PORT=4000
NODE_ENV=development

# SQLite file. Created on first run.
DATABASE_FILE=./data/cricket-polls.sqlite

# Salt used to hash voter IPs. Change it in production; changing it later
# resets the IP-based backup guard.
IP_HASH_SALT=change-this-salt

# Backup double-vote guard: max votes accepted from one IP per poll.
# Deliberately generous -- a whole stand shares one stadium NAT address.
MAX_VOTES_PER_IP_PER_POLL=40

# '*' or a comma-separated list of allowed origins.
CORS_ORIGIN=*
